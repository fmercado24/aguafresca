{
  "name": "aguafresca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestión administrativa y de clientes — Agua Fresca SpA · Fundo Entre Ríos",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit -p client && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "sanitize-html": "^2.18.1"
  }
}
